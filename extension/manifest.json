{
  "manifest_version": 3,
  "name": "Chronicle 网页采集",
  "short_name": "Chronicle",
  "version": "0.4.0",
  "description": "Background-captures web conversations from ChatGPT, Claude, Gemini, Perplexity, and Grok into the local Chronicle (hstry) archive.",
  "key": "",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Chronicle 网页采集",
    "default_popup": "popup.html"
  }
}
